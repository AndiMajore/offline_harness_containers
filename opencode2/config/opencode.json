{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "share": "disabled",
  "model": "{env:OPENCODE_PROVIDER_ID}/{env:OPENAI_MODEL}",
  "providers": {
    "{env:OPENCODE_PROVIDER_ID}": {
      "name": "{env:OPENCODE_PROVIDER_NAME}",
      "package": "@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "{env:OPENAI_BASE_URL}",
        "apiKey": "{env:OPENAI_API_KEY}"
      },
      "models": {
        "{env:OPENAI_MODEL}": {
          "name": "{env:OPENAI_MODEL}",
          "limit": {
            "context": {env:OPENAI_CONTEXT_WINDOW},
            "output": {env:OPENAI_MAX_OUTPUT_TOKENS}
          }
        }
      }
    }
  }
}
