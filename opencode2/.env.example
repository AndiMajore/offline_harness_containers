# Route all traffic through the whitelisting proxy (service name from docker-compose.yml)
HTTP_PROXY=http://llm-proxy:3128
HTTPS_PROXY=http://llm-proxy:3128
http_proxy=http://llm-proxy:3128
https_proxy=http://llm-proxy:3128
NO_PROXY=localhost,127.0.0.1
no_proxy=localhost,127.0.0.1

# OpenAI-compatible LLM endpoint (its domain must be whitelisted in squid.conf)
OPENAI_BASE_URL=https://llm.example.com/v1
OPENAI_API_KEY=changeme

# Default model, registered as "<OPENCODE_PROVIDER_ID>/<OPENAI_MODEL>" (config/opencode.json)
OPENAI_MODEL=gpt-oss:20b
OPENAI_CONTEXT_WINDOW=131072
OPENAI_MAX_OUTPUT_TOKENS=32768
OPENCODE_PROVIDER_ID=llm
OPENCODE_PROVIDER_NAME=OpenAI-compatible endpoint

# Model discovery: on every start, all models from $OPENAI_BASE_URL/models are
# offered in OpenCode (the limits above apply to each). Regexes, case-insensitive:
OPENCODE_MODELS_INCLUDE=
OPENCODE_MODELS_EXCLUDE=embed|rerank|bge-

# Password for the web UI / API; the CLI inside the container uses it too.
# generate with: openssl rand -hex 24
OPENCODE_PASSWORD=changeme

# No calls to models.dev / update servers from inside the sandbox
OPENCODE_DISABLE_MODELS_FETCH=true
OPENCODE_DISABLE_AUTOUPDATE=true

# Image tag (OpenCode v2 releases: ghcr.io/anomalyco/opencode:2.x)
OPENCODE_VERSION=2.0.32
# Host port for the web UI (bound to 127.0.0.1)
OPENCODE_PORT=4096
# Run as your host user so ./workspace and ./data stay owned by you
OPENCODE_UID=1000
OPENCODE_GID=1000

# Where OpenCode keeps its state (sessions, config, logs):
#   ./data         -> folder next to this file (default)
#   opencode-data  -> Docker-managed named volume
OPENCODE_DATA=./data

# Web UI is off by default (interactive CLI only). Uncomment to publish it on 127.0.0.1:
#COMPOSE_PROFILES=ui
