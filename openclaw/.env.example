# Route all traffic through the whitelisting proxy (service name from docker-compose.yml)
HTTP_PROXY=http://llm-proxy:3128
HTTPS_PROXY=http://llm-proxy:3128
http_proxy=http://llm-proxy:3128
https_proxy=http://llm-proxy:3128
NO_PROXY=localhost,127.0.0.1
no_proxy=localhost,127.0.0.1

# OpenAI-compatible LLM endpoint (its domain must be whitelisted in squid.conf)
OPENAI_BASE_URL=https://llm.example.com/v1
OPENAI_API_KEY=changeme

# Token required to connect to the gateway UI / API
# generate with: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=changeme

# Default provider + model, written to data/openclaw.json on every `docker compose up`
# (by the openclaw-config service). Leave OPENCLAW_MODEL empty to keep openclaw.json as is.
#   provider: config key of the provider; "custom" = any OpenAI-compatible endpoint
#   The API key is taken from OPENAI_API_KEY (stored as an env reference, never in the file).
OPENCLAW_PROVIDER=custom
OPENCLAW_MODEL=gpt-oss:20b
# Optional display name in the UI (defaults to OPENCLAW_MODEL)
OPENCLAW_MODEL_NAME=
OPENCLAW_BASE_URL=${OPENAI_BASE_URL}

# Model discovery: on every start, all models from $OPENCLAW_BASE_URL/models are
# added to the provider (set to false to only use OPENCLAW_MODEL). Regexes, case-insensitive:
OPENCLAW_MODELS_DISCOVERY=true
OPENCLAW_MODELS_INCLUDE=
OPENCLAW_MODELS_EXCLUDE=embed|rerank|bge-

# Where OpenClaw keeps its state (openclaw.json, sessions, agents, workspace):
#   ./data         -> folder next to this file (default, easy to back up / inspect)
#   openclaw-data  -> Docker-managed named volume
OPENCLAW_DATA=./data

# Web UI is off by default (interactive CLI only). Uncomment to publish it on 127.0.0.1:
#COMPOSE_PROFILES=ui
