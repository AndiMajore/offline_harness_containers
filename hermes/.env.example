# Route all traffic through the whitelisting proxy (service name from docker-compose.yml)
HTTP_PROXY=http://llm-proxy:3128
HTTPS_PROXY=http://llm-proxy:3128
http_proxy=http://llm-proxy:3128
https_proxy=http://llm-proxy:3128
NO_PROXY=localhost,127.0.0.1
no_proxy=localhost,127.0.0.1

# OpenAI-compatible LLM endpoint (its domain must be whitelisted in squid.conf)
OPENAI_BASE_URL=https://llm.example.com/v1
OPENAI_API_KEY=changeme

# Run as this host UID/GID so files in ./data are owned by you
HERMES_UID=1000
HERMES_GID=1000

# Default provider + model, written to data/config.yaml on every `docker compose up`
# (by the hermes-config service). Leave a value empty to keep what's in config.yaml.
#   provider: "custom" = any OpenAI-compatible endpoint (Ollama, vLLM, Open WebUI, ...)
#             others: openrouter, anthropic, nous, gemini, ... (their domain must be in squid.conf)
HERMES_PROVIDER=custom
HERMES_MODEL=gpt-oss:20b
HERMES_BASE_URL=${OPENAI_BASE_URL}

# Where Hermes keeps its state (config.yaml, sessions, memories, skills):
#   ./data       -> folder next to this file (default, easy to back up / inspect)
#   hermes-data  -> Docker-managed named volume
HERMES_DATA=./data
